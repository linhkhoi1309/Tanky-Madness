:root {
    -unity-font-definition: url("project://database/Assets/Fonts/PottaOne-Regular.ttf?fileID=12800000&guid=edd46e655e95d354ba7d0ff2c2e721dd&type=3#PottaOne-Regular");
}

.text {
    color: rgb(200, 200, 200);
}

.button {
    background-color: rgba(0, 0, 0, 0.51);
    border-top-left-radius: 16px;
    border-top-right-radius: 16px;
    border-bottom-right-radius: 16px;
    border-bottom-left-radius: 16px;
    color: rgb(200, 200, 200);
    margin-top: 4px;
    margin-bottom: 4px;
    margin-right: 0;
    margin-left: 0;
    justify-content: space-evenly;
}

.panel {
    align-content: center;
    padding-top: 32px;
    padding-right: 32px;
    padding-bottom: 32px;
    padding-left: 32px;
    background-color: rgba(0, 0, 0, 0.78);
    justify-content: center;
}

.translate-transition {
    transition-property: translate;
    transition-timing-function: ease-in-out;
    transition-duration: 0.1306s;
}

.shown {
    translate: 0% 0%;
}

.hidden-left {
    translate: -100% 0;
}

.hidden-right {
    translate: 100% 0;
}

.hidden-top {
    translate: 0 -100%;
}

.hidden-bottom {
    translate: 0 100%;
}

.fullscreen {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.sticky-left {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: auto;
}

.text-big {
    font-size: 32px;
}

.text-centered {
    -unity-text-align: upper-center;
}

.grow {
    flex-grow: 1;
}

.items-centered {
    align-items: center;
}

.hidden {
    display: none;
}


